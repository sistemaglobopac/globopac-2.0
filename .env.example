# Copie para .env.local e preencha com os valores do seu ambiente.
# NUNCA commitar .env / .env.local (ver .gitignore). Chaves reais vivem em
# secrets do GitHub Actions / do provedor de deploy, nunca em texto no repo.

# --- Frontend (Vite expõe apenas variáveis prefixadas com VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (uso local via CLI: `supabase start` preenche automaticamente) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: somente em Edge Functions / CI de deploy. Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Observabilidade ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Autoridades de carimbo de tempo (RFC 3161) — Fase 2 ---
# Nenhuma credencial é necessária para FreeTSA/Sectigo/Comodo/Certum no modo público;
# se uma conta dedicada for usada no futuro, as credenciais entram aqui, nunca no código.
TSA_PRIMARIA_URL=https://freetsa.org/tsr
TSA_FALLBACK_1_URL=
TSA_FALLBACK_2_URL=
TSA_FALLBACK_3_URL=

# --- Canal de alerta operacional (seção 9 do PROMPT MESTRE — placeholder, ver ASSUMPTIONS.md #6) ---
ALERTA_EMAIL_DESTINATARIOS=
