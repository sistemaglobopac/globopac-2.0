# Copie para .env.local e preencha com os valores do seu ambiente.
# NUNCA commitar .env / .env.local (ver .gitignore). Chaves reais vivem em
# secrets do GitHub Actions / do provedor de deploy, nunca em texto no repo.

# --- Frontend (Vite expõe apenas variáveis prefixadas com VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# hCaptcha (CAPTCHA de "comprovação humana" após 5 falhas de login — ADR 0015). Trocado do
# Cloudflare Turnstile por um bug de conta do lado da Cloudflare ("400020 invalid sitekey" em
# toda sitekey real, só a de teste funcionava). O valor abaixo é a SITE KEY DE TESTE PÚBLICA do
# hCaptcha (sempre passa, visível) — use-a em dev/CI. Produção precisa da site key REAL de
# dashboard.hcaptcha.com (o secret correspondente vai em HCAPTCHA_SECRET_KEY, nunca aqui).
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# --- Supabase (uso local via CLI: `supabase start` preenche automaticamente) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: somente em Edge Functions / CI de deploy. Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Observabilidade ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Autoridades de carimbo de tempo (RFC 3161) — Fase 2 ---
# Nenhuma credencial é necessária para FreeTSA/Sectigo/Comodo/Certum no modo público;
# se uma conta dedicada for usada no futuro, as credenciais entram aqui, nunca no código.
TSA_PRIMARIA_URL=https://freetsa.org/tsr
TSA_FALLBACK_1_URL=
TSA_FALLBACK_2_URL=
TSA_FALLBACK_3_URL=

# --- Canal de alerta operacional (seção 9 do PROMPT MESTRE — placeholder, ver ASSUMPTIONS.md #6) ---
ALERTA_EMAIL_DESTINATARIOS=

# --- Segurança de login: bloqueio por IP (ADR 0015) ---
# Secrets das Edge Functions (login, desbloquear-ip-login) — NÃO são lidas pelo Vite. Local:
# exporte no shell antes de `supabase start`, ou coloque em supabase/.env (gitignorado, lido
# automaticamente pelo CLI). Hospedado: `supabase secrets set NOME=valor`.
#
# HCAPTCHA_SECRET_KEY: par do VITE_HCAPTCHA_SITE_KEY acima. O valor abaixo é o SECRET DE TESTE
# PÚBLICO do hCaptcha (sempre aprova) — troque pelo secret real em produção.
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
# ALLOWED_ORIGINS: lista separada por vírgula das origens que podem chamar as Edge Functions
# autenticadas (CORS restrito — nunca "*"). Sem configurar, só localhost:5173/4173 funcionam
# (ver supabase/functions/_shared/cors.ts). Produção: domínio real do frontend.
ALLOWED_ORIGINS=
